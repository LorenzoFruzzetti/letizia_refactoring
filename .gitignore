# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/

# Package editable install artifacts
src/*.egg-info/

# Local virtualenv created by .env/install_linux.sh --mode venv
.venv/

# Outputs
outputs/
examples/output/
experiments/output/

# Per-pixel dumps written by run_botox_batch.py --save-data
# (save_data_root = "pixel_data"). ~197 MB per recording, ~70 GB for the full
# manifest -- regenerable from the raw TIFFs on D:, so never commit it.
pixel_data/

# Console transcript of a full run_botox_batch.py batch.
batch_run.log

# Transient working files (benchmark inputs/results are regenerated by
# benchmarks/benchmark_modalities.py; see CLAUDE.md section 5.2)
temporary_files/
temp_image/

# MATLAB parity reference (regenerate with gen_reference.m; ~23 MB)
tests/matlab_reference/reference.mat

# Large local-only reference material (not redistributed via this repo)
# - the lab protocol document is unpublished; keep it out of a public history
# - the paper is open access; see README.md for the DOI instead of a 1.5 MB copy
Antea_scripts/Analisi WF - Nuove.docx
Microglial extracellular vesicles induce.pdf

# OS
.DS_Store
Thumbs.db
